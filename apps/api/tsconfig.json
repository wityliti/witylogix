{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@repo/core": ["../../packages/repo-core/src/index.ts"],
      "@repo/core/*": ["../../packages/repo-core/src/*"],
      "@repo/db": ["../../packages/repo-db/src/index.ts"],
      "@repo/db/*": ["../../packages/repo-db/src/*"],
      "@witylogix/core/integrations/traffic/index.js": [
        "../../packages/core/src/integrations/traffic/index.ts"
      ],
      "@witylogix/core/integrations/ecommerce/index.js": [
        "../../packages/core/src/integrations/ecommerce/index.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}

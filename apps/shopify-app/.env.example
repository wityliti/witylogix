# ─── Shopify App ─────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_shipping,write_shipping,read_locations,read_inventory,write_inventory,read_customers
SHOPIFY_WEBHOOK_SECRET=

# ─── Backend API ─────────────────────────────────────────
# No trailing slash. Point local Shopify dev at production API:
#   API_BASE_URL=https://api.witylogix.com
API_BASE_URL=http://localhost:8000

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/witylogix

# ─── Error Tracking (optional) ──────────────────────────
SENTRY_DSN=                   # Sentry DSN for error tracking (optional)

# ─── Rate Limiting ──────────────────────────────────────
# Default: 200 webhooks/min per shop (in-memory)
# For multi-instance: set REDIS_URL for distributed rate limiting
# REDIS_URL=redis://...

FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

# Build workspace packages that API depends on
RUN cd packages/db && npx prisma generate --schema=prisma/schema
RUN cd packages/db && npx tsc || true
RUN cp -r packages/db/src/generated packages/db/dist/generated 2>/dev/null || true
RUN cd packages/types && npx tsc || true
RUN cd packages/validators && npx tsup src/index.ts --format cjs,esm --dts 2>/dev/null || true
RUN cd packages/framework && npx tsup 2>/dev/null || true

FROM node:20-alpine
RUN npm install -g tsx && apk add --no-cache dumb-init curl
WORKDIR /app
COPY --from=builder /app ./
ENV NODE_ENV=production
EXPOSE 3000
CMD ["dumb-init", "tsx", "apps/api/src/server.ts"]

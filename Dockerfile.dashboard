FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NEXT_TELEMETRY_DISABLED=1
RUN cd apps/dashboard && npx next build

# Collect optional public dir
RUN mkdir -p /tmp/public && \
    (cp -r apps/dashboard/public/* /tmp/public/ 2>/dev/null || true)

FROM node:20-alpine
RUN apk add --no-cache dumb-init
WORKDIR /app/apps/dashboard
COPY --from=builder /app/apps/dashboard/.next/standalone/apps/dashboard/ ./
COPY --from=builder /app/apps/dashboard/.next/static ./.next/static
COPY --from=builder /tmp/public ./public
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
EXPOSE 3000
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]

# ═══════════════════════════════════════════════════════════════════════════════
# Test Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Configuration for test suite execution (unit tests, integration tests, e2e tests)
# These values are deterministic and use local/mock services to ensure fast,
# reproducible test runs without external dependencies.

# ─── SERVER CONFIGURATION ─────────────────────────────────────────────────────

# Test environment
NODE_ENV=test

# Server port for test API
PORT=8001

# Verbose logging for test debugging
LOG_LEVEL=debug

# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────────
# Use SQLite for fast, in-memory testing (or test Postgres instance)
# For SQLite: file:memdb?mode=memory&cache=shared
# For Postgres: postgresql://test:test@localhost:5433/witylogix_test

DATABASE_URL="file:memdb?mode=memory&cache=shared"

# Test database pool size (small for tests)
DATABASE_POOL_SIZE=5

# ─── REDIS CONFIGURATION ──────────────────────────────────────────────────────
# Use local Redis or mock service
REDIS_URL="redis://localhost:6380"

# ─── JWT AUTHENTICATION ──────────────────────────────────────────────────────
# Deterministic secret key for reproducible tests
# MUST be exactly 32+ characters
JWT_SECRET=test-secret-key-exactly-32-characters-long!

# Token expiry times (shorter for tests)
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=24h

# ─── SMTP EMAIL CONFIGURATION ────────────────────────────────────────────────
# Use mock/test email service
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=testuser
SMTP_PASSWORD=testpass

# ─── TWILIO SMS CONFIGURATION ────────────────────────────────────────────────
# Test Twilio credentials (use test account)
TWILIO_SID=ACtest123456789test123456789test
TWILIO_AUTH_TOKEN=test123456789test123456789testtoken
TWILIO_PHONE=+11111111111

# ─── STRIPE PAYMENT CONFIGURATION ───────────────────────────────────────────
# Stripe test mode keys (pk_test_* and sk_test_*)
# See: https://stripe.com/docs/testing
STRIPE_SECRET_KEY=sk_test_123456789test123456789test
STRIPE_WEBHOOK_SECRET=whsec_test123456789test

# ─── SENTRY ERROR TRACKING ────────────────────────────────────────────────────
# No error tracking during tests (avoid polluting Sentry with test errors)
# SENTRY_DSN=
SENTRY_ENVIRONMENT=test

# ─── GEOLOCATION & MAPPING ────────────────────────────────────────────────────
# Test API keys (limited/test accounts if available)
MAPBOX_TOKEN=pk.test_123456789test
GOOGLE_MAPS_KEY=AIzaSyDtest123456789test

# ─── SHOPIFY INTEGRATION ──────────────────────────────────────────────────────
# Test Shopify credentials (from Shopify test account)
SHOPIFY_API_KEY=test_api_key_123456789
SHOPIFY_API_SECRET=test_api_secret_123456789test

# ─── AWS S3 STORAGE ───────────────────────────────────────────────────────────
# Use LocalStack or moto for S3 testing
S3_BUCKET=test-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=testing
S3_SECRET_KEY=testing

# ─── APPLICATION URLS ────────────────────────────────────────────────────────
# Local test URLs
APP_URL=http://localhost:3002
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3001

# ─── E2E TEST CONFIGURATION ──────────────────────────────────────────────────

# Base URL for Playwright E2E tests
BASE_URL=http://localhost:3002

# Test user credentials (deterministic for reproducible tests)

# Admin user for testing admin features
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=admin123

# Dispatcher user for testing dispatch features
TEST_DISPATCHER_EMAIL=dispatcher@test.com
TEST_DISPATCHER_PASSWORD=dispatcher123

# Driver user for testing driver app
TEST_DRIVER_EMAIL=driver@test.com
TEST_DRIVER_PASSWORD=driver123

# ─── CI/CD ENVIRONMENT DETECTION ──────────────────────────────────────────

# Set to true when running in CI (GitHub Actions, CircleCI, etc.)
# Used to adjust timeouts and logging behavior
CI=false

# Playwright browser download behavior
# Skip download if using pre-installed browsers in CI
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=false

# ─── TEST-SPECIFIC TIMEOUTS ───────────────────────────────────────────────────

# Test timeout (faster than production)
TEST_TIMEOUT=10000

# Database operation timeout (tests should be fast)
DB_TIMEOUT=5000

# API request timeout (tests use local services)
API_TIMEOUT=5000

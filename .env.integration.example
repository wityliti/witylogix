# ───────────────────────────────────────────────────────────
# Google Maps & Calendar Integration Environment Variables
# ───────────────────────────────────────────────────────────

# Google Maps API Configuration
# Get from: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth2 Configuration (for Calendar Integration)
# Get from: https://console.cloud.google.com/ > Credentials > OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# API Base URL Configuration
API_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Shopify Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_API_SCOPES=write_products,write_orders,read_customers

# ───────────────────────────────────────────────────────────
# Optional: Google Maps Rate Limiting
# ───────────────────────────────────────────────────────────

# Maximum daily requests to Google Maps API
GOOGLE_MAPS_DAILY_LIMIT=25000

# Cache TTL in seconds (default: 3600)
GOOGLE_MAPS_CACHE_TTL=3600

# ───────────────────────────────────────────────────────────
# Optional: Delivery Configuration
# ───────────────────────────────────────────────────────────

# Minimum lead time for delivery (minutes)
DELIVERY_MINIMUM_LEAD_TIME=240

# Default delivery slot duration (minutes)
DELIVERY_SLOT_DURATION=180

# Maximum delivery distance (miles)
DELIVERY_MAX_DISTANCE=25

# ───────────────────────────────────────────────────────────
# Optional: Calendar Configuration
# ───────────────────────────────────────────────────────────

# Default calendar ID (primary or specific)
GOOGLE_CALENDAR_ID=primary

# Calendar event color (1-11 for Google Calendar colors)
GOOGLE_CALENDAR_EVENT_COLOR=1

# ───────────────────────────────────────────────────────────
# Database Configuration (for integration data)
# ───────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/witylogix

# ───────────────────────────────────────────────────────────
# Integration Session Configuration
# ───────────────────────────────────────────────────────────

# OAuth2 state expiration (minutes)
OAUTH_STATE_EXPIRY=10

# Session token expiration (hours)
SESSION_TOKEN_EXPIRY=24

# ───────────────────────────────────────────────────────────
# Zone Configuration
# ───────────────────────────────────────────────────────────

# Enable zone visualization
ENABLE_ZONE_VISUALIZATION=true

# Zone boundary simplification tolerance (degrees)
ZONE_SIMPLIFICATION_TOLERANCE=0.0001

# ───────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────

LOG_LEVEL=debug
API_LOG_LEVEL=debug

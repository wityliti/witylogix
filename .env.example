# ═══════════════════════════════════════════════════════════════════════════════
# Witylogix Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in values for your environment.
# Variables marked with [REQUIRED] must be set in all environments.
# See docs/deployment/SECRETS_ROTATION.md for rotating secrets in production.

# ─── SERVER CONFIGURATION ──────────────────────────────────────────────────────

# Node environment. Controls feature flags, logging, and error handling.
# [REQUIRED] Allowed: development, staging, production
NODE_ENV=development

# Server port for HTTP API
# Default: 8000
PORT=8000

# Logging level. Higher granularity: error < warn < info < debug
# Default: info (use debug for local development)
LOG_LEVEL=info

# ─── DATABASE CONFIGURATION ────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string with full credentials
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
# Example: postgresql://witylogix:witylogix_dev@localhost:5432/witylogix?schema=public
# See: https://www.postgresql.org/docs/current/libpq-envars.html

DATABASE_URL="postgresql://witylogix:witylogix_dev@localhost:5432/witylogix?schema=public"

# Connection pool size (for production, typically 20-50)
# Default: 20
DATABASE_POOL_SIZE=20

# Read-only replica URL for read scaling (optional)
# Format: same as DATABASE_URL but for read-only replica
# DATABASE_READ_REPLICA_URL="postgresql://user:pass@replica.example.com:5432/witylogix?schema=public"

# ─── REDIS CONFIGURATION ──────────────────────────────────────────────────────
# [REQUIRED] Redis connection string for caching, sessions, and job queues
# Format: redis://[password]@[host]:[port]/[db_number]
# Example: redis://localhost:6379 (no auth)
# Example: redis://password@localhost:6379/0 (with auth)
# See: https://github.com/luin/ioredis#connection-string

REDIS_URL="redis://localhost:6379"

# Redis password (if not in URL)
# REDIS_PASSWORD=

# ─── JWT AUTHENTICATION ────────────────────────────────────────────────────────
# [REQUIRED] Secret key for JWT token signing and verification
# Min 32 characters for production. Generate with:
#   openssl rand -base64 32
# or
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

JWT_SECRET=your-secure-secret-key-min-32-chars-required

# JWT access token expiry time (format: https://github.com/zeit/ms)
# Default: 24h (24 hours)
JWT_ACCESS_EXPIRY=24h

# JWT refresh token expiry time
# Default: 7d (7 days)
JWT_REFRESH_EXPIRY=7d

# ─── SMTP EMAIL CONFIGURATION ─────────────────────────────────────────────────
# Optional SMTP configuration for transactional emails
# For development, you can use https://mailtrap.io or https://mailhog.example.com

# SMTP server hostname
# SMTP_HOST=smtp.example.com

# SMTP server port
# Default: 587 (TLS) or 465 (SSL)
# SMTP_PORT=587

# SMTP username
# SMTP_USER=

# SMTP password
# SMTP_PASSWORD=

# ─── TWILIO SMS CONFIGURATION ─────────────────────────────────────────────────
# Optional SMS configuration via Twilio
# See: https://www.twilio.com/console/account/keys

# Twilio Account SID
# TWILIO_SID=

# Twilio Auth Token
# TWILIO_AUTH_TOKEN=

# Twilio phone number for SMS (E.164 format: +1234567890)
# TWILIO_PHONE=

# ─── STRIPE PAYMENT CONFIGURATION ────────────────────────────────────────────
# Optional Stripe integration for payments
# See: https://dashboard.stripe.com/apikeys

# Stripe secret API key (starts with sk_test_ or sk_live_)
# [REQUIRED for payments feature]
# STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_)
# [REQUIRED for webhook verification]
# STRIPE_WEBHOOK_SECRET=

# ─── SENTRY ERROR TRACKING ────────────────────────────────────────────────────
# Optional Sentry integration for error tracking and monitoring
# See: https://sentry.io/settings/

# Sentry project DSN (Data Source Name)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry environment tag
# SENTRY_ENVIRONMENT=development

# ─── GEOLOCATION & MAPPING ────────────────────────────────────────────────────
# API keys for location services and mapping

# Mapbox API token for routing and geocoding
# Get from: https://account.mapbox.com/tokens/
# MAPBOX_TOKEN=

# Google Maps API key for routing and geocoding
# Get from: https://console.cloud.google.com/
# GOOGLE_MAPS_KEY=

# ─── SHOPIFY INTEGRATION ──────────────────────────────────────────────────────
# Optional Shopify app configuration
# Get from: https://partners.shopify.com/ → Your Apps → API credentials

# Shopify API key
# SHOPIFY_API_KEY=

# Shopify API secret
# SHOPIFY_API_SECRET=

# ─── AWS S3 STORAGE ───────────────────────────────────────────────────────────
# Optional AWS S3 configuration for file storage
# Get from: https://console.aws.amazon.com/iam/

# S3 bucket name
# S3_BUCKET=

# AWS region (e.g., us-east-1, eu-west-1)
# S3_REGION=

# AWS access key ID
# S3_ACCESS_KEY=

# AWS secret access key
# S3_SECRET_KEY=

# ─── APPLICATION URLS ────────────────────────────────────────────────────────
# [REQUIRED] Public-facing URLs for the application

# Public app URL (for tracking links, OAuth redirects, etc.)
# Used in: tracking links, OAuth callback URLs, email links
APP_URL="http://localhost:3000"

# API base URL (for internal service-to-service communication)
# If omitted, defaults to APP_URL
# API_URL="http://localhost:8000"

# Dashboard URL (for admin interface links)
# DASHBOARD_URL="http://localhost:3001"

# ═══════════════════════════════════════════════════════════════════════════════
# DEVELOPMENT-ONLY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# These are optional and typically only used in development

# PostgreSQL superuser password (for local setup only, not runtime)
# POSTGRES_PASSWORD=witylogix_dev

# Enable debug mode for verbose logging
# DEBUG=false

# Custom log format: json or text
# LOG_FORMAT=text

# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT CHECKLIST
# ═══════════════════════════════════════════════════════════════════════════════
# Before deploying to production, ensure:
# ✓ All [REQUIRED] variables are set with secure values
# ✓ JWT_SECRET is a strong random string (min 32 chars)
# ✓ All API keys and secrets come from production accounts
# ✓ APP_URL uses https:// protocol
# ✓ DATABASE_URL points to production database with backups enabled
# ✓ REDIS_URL points to Redis cluster with replication
# ✓ All external services are configured and tested
# ✓ Monitoring/logging (Sentry, CloudWatch) is configured
# ✓ Run deployment checklist: npm run check:deployment
# ✓ Review secrets rotation: docs/deployment/SECRETS_ROTATION.md

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://witylogix:witylogix_dev@localhost:5432/witylogix?schema=public"
POSTGRES_PASSWORD=witylogix_dev

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Shopify ─────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_shipping,write_shipping,read_locations,read_inventory,write_inventory,read_customers

# ─── Routing Provider ───────────────────────────────────────
# "mapbox" (Phase 1, default) or "osrm" (Phase 2)
ROUTING_PROVIDER=mapbox

# Phase 1: Mapbox
MAPBOX_ACCESS_TOKEN=

# Phase 2: Self-hosted OSRM (uncomment when migrating)
# OSRM_BASE_URL="http://localhost:5000"
# SOLVER_URL="http://localhost:8080"

# ─── Notifications ──────────────────────────────────────────
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Firebase (Driver App Push Notifications) ───────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
TRACKING_PAGE_URL="http://localhost:3002"

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string. Required for app startup.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://witylogix:witylogix_dev@localhost:5432/witylogix?schema=public"

# PostgreSQL superuser password (used during setup only, not required at runtime)
POSTGRES_PASSWORD=witylogix_dev

# ─── Redis ───────────────────────────────────────────────────
# Redis connection string. Required for caching, sessions, and job queues.
# Format: redis://[password]@[host]:[port]/[db_number]
REDIS_URL="redis://localhost:6379"

# ─── Shopify ─────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_shipping,write_shipping,read_locations,read_inventory,write_inventory,read_customers

# ─── Routing Provider ───────────────────────────────────────
# Determines which routing engine handles delivery route optimization and distance calculations.
# Supported: mapbox (default), osrm, google_maps, here, graphhopper, tomtom
# This is the deployer's default. Tenants can override when ROUTING_BYOK=true.
ROUTING_PROVIDER=mapbox

# BYOK (Bring Your Own Key) mode for routing:
#   "false" (default) — all tenants share the deployer's credentials
#   "true"            — tenants choose their own provider + credentials
#                       via Settings → Routing. Fallback usage is metered.
ROUTING_BYOK=false

# ── Provider Credentials (set the one matching ROUTING_PROVIDER) ──

# Mapbox (default) — Used for route optimization, geocoding, distance matrix
# API Key from https://account.mapbox.com/tokens/
MAPBOX_ACCESS_TOKEN=

# OSRM (self-hosted) — Open Source Routing Machine for routing + matrix queries, no geocoding
# OSRM_BASE_URL="http://localhost:5000"

# Google Maps (coming soon) — Alternative routing and geocoding provider
# GOOGLE_MAPS_API_KEY=

# HERE (coming soon) — Alternative routing and geocoding provider
# HERE_API_KEY=

# GraphHopper (coming soon) — Alternative open-source routing provider
# GRAPHHOPPER_API_KEY=

# TomTom (coming soon) — Alternative routing and geocoding provider
# TOMTOM_API_KEY=

# ─── Notification Providers ─────────────────────────────────
# Multi-channel notification system with BYOK support (same pattern as routing).
# Each channel (email, SMS, WhatsApp, push) has its own default provider.
# Tenants can override when NOTIFICATIONS_BYOK=true.

# BYOK (Bring Your Own Key) mode for notifications:
#   "false" (default) — all tenants share the deployer's credentials
#   "true"            — tenants choose their own provider + credentials
#                       via Settings → Notifications. Fallback usage is metered.
NOTIFICATIONS_BYOK=false

# ── Email Provider ─────────────────────────────────────────
# Transactional email service for order confirmations, delivery updates, etc.
# Supported: sendgrid (default), mailgun, aws_ses, postmark, resend, smtp
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Mailgun (coming soon) — Alternative email provider
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# Resend (coming soon) — Alternative email provider
# RESEND_API_KEY=

# Postmark (coming soon) — Transactional email specialist
# POSTMARK_SERVER_TOKEN=

# SMTP / Generic (coming soon) — Self-hosted email sending
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Email sender configuration (required for all email providers)
# Email address and display name shown in From: header
EMAIL_FROM=
EMAIL_FROM_NAME=

# ── SMS Provider ───────────────────────────────────────────
# SMS notifications for delivery tracking and alerts.
# Supported: twilio (default), vonage, aws_sns, messagebird, plivo
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vonage (coming soon) — Alternative SMS provider
# VONAGE_API_KEY=
# VONAGE_API_SECRET=

# ── WhatsApp Provider ─────────────────────────────────────
# WhatsApp notifications for delivery tracking and customer support.
# Supported: meta_cloud (default), twilio_whatsapp, 360dialog
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Push Notification Provider ─────────────────────────────
# In-app push notifications for driver apps and customer tracking.
# Supported: firebase (default), onesignal, expo_push
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# OneSignal (coming soon) — Alternative push notification service
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=

# ─── JWT (Authentication) ────────────────────────────────────
# Secret key for JWT token signing. Required for authentication.
# Should be a long, random string (min 32 characters for production).
# Generate with: openssl rand -base64 32
JWT_SECRET=

# JWT token expiration time. Default: 7d (7 days)
# Supports formats like: 7d, 24h, 3600s
JWT_EXPIRES_IN=7d

# ─── Shopify Integration ──────────────────────────────────────
# Shopify API credentials for app installation and webhook handling.
# Retrieved from Shopify Partner Dashboard → Your Apps → API credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_shipping,write_shipping,read_locations,read_inventory,write_inventory,read_customers

# ─── AI/LLM Integration ───────────────────────────────────────
# Anthropic Claude API for AI-powered features (route optimization, customer support, etc.)
ANTHROPIC_API_KEY=

# ─── Application Configuration ────────────────────────────────
# Environment mode: development, staging, production
# Affects logging, error handling, and feature flags
NODE_ENV=development

# Server port for HTTP API
PORT=8000

# Logging level: debug, info, warn, error
# Higher granularity: error < warn < info < debug
LOG_LEVEL=info

# Public-facing URL for tracking page (customer delivery tracking interface)
# Used in tracking links sent to customers
TRACKING_PAGE_URL="http://localhost:3002"

# Optional: API base URL for internal service-to-service communication
# Example: https://api.example.com
# API_BASE_URL=

# Optional: Frontend URL for CORS and redirect configurations
# Example: https://app.example.com
# FRONTEND_URL=

# Optional: Debug mode for detailed logging and verbose output
# DEBUG=false

# Optional: Custom log format for structured logging
# LOG_FORMAT=json or text (default: text)

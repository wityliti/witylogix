# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://witylogix:witylogix_dev@localhost:5432/witylogix?schema=public"
POSTGRES_PASSWORD=witylogix_dev

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Shopify ─────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_fulfillments,write_fulfillments,read_shipping,write_shipping,read_locations,read_inventory,write_inventory,read_customers

# ─── Routing Provider ───────────────────────────────────────
# Supported: mapbox (default), osrm, google_maps, here, graphhopper, tomtom
# This is the deployer's default. Tenants can override when BYOK=true.
ROUTING_PROVIDER=mapbox

# BYOK (Bring Your Own Key) mode:
#   "false" (default) — all tenants share the deployer's credentials
#   "true"            — tenants choose their own provider + credentials
#                       via Settings → Routing. Fallback usage is metered.
ROUTING_BYOK=false

# ── Provider Credentials (set the one matching ROUTING_PROVIDER) ──

# Mapbox (default)
MAPBOX_ACCESS_TOKEN=

# OSRM (self-hosted — routing + matrix, no geocoding)
# OSRM_BASE_URL="http://localhost:5000"

# Google Maps (coming soon)
# GOOGLE_MAPS_API_KEY=

# HERE (coming soon)
# HERE_API_KEY=

# GraphHopper (coming soon)
# GRAPHHOPPER_API_KEY=

# TomTom (coming soon)
# TOMTOM_API_KEY=

# ─── Notification Providers ─────────────────────────────────
# Multi-provider, BYOK-aware — same pattern as routing.
# Each channel has its own default provider. Tenants can override
# when NOTIFICATIONS_BYOK=true.

# BYOK (Bring Your Own Key) mode for notifications:
#   "false" (default) — all tenants share the deployer's credentials
#   "true"            — tenants choose their own provider + credentials
#                       via Settings → Notifications. Fallback usage is metered.
NOTIFICATIONS_BYOK=false

# ── Email Provider ─────────────────────────────────────────
# Supported: sendgrid (default), mailgun, aws_ses, postmark, resend, smtp
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Mailgun (coming soon)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# Resend (coming soon)
# RESEND_API_KEY=

# Postmark (coming soon)
# POSTMARK_SERVER_TOKEN=

# SMTP / Generic (coming soon)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Email sender (all providers)
EMAIL_FROM=
EMAIL_FROM_NAME=

# ── SMS Provider ───────────────────────────────────────────
# Supported: twilio (default), vonage, aws_sns, messagebird, plivo
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vonage (coming soon)
# VONAGE_API_KEY=
# VONAGE_API_SECRET=

# ── WhatsApp Provider ─────────────────────────────────────
# Supported: meta_cloud (default), twilio_whatsapp, 360dialog
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Push Provider ─────────────────────────────────────────
# Supported: firebase (default), onesignal, expo_push
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# OneSignal (coming soon)
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
TRACKING_PAGE_URL="http://localhost:3002"

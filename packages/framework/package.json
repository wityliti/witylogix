{
  "name": "@witylogix/framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./workflow": {
      "import": "./dist/workflow/index.mjs",
      "require": "./dist/workflow/index.cjs",
      "types": "./dist/workflow/index.d.ts"
    },
    "./container": {
      "import": "./dist/container/index.mjs",
      "require": "./dist/container/index.cjs",
      "types": "./dist/container/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./queue": {
      "import": "./dist/queue/index.mjs",
      "require": "./dist/queue/index.cjs",
      "types": "./dist/queue/index.d.ts"
    }
  },
  "scripts": {
    "build": "echo build-ok",
    "test": "vitest run"
  },
  "dependencies": {
    "@witylogix/db": "workspace:*",
    "@witylogix/types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^1.0.0"
  }
}

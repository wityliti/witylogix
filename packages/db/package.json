{
  "name": "@witylogix/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./helpers": {
      "import": "./src/helpers.ts",
      "types": "./src/helpers.ts"
    }
  },
  "scripts": {
    "build": "node -e \"try{require('fs').accessSync('src/generated/prisma/index.d.ts')}catch(e){process.exit(1)}\" || npx prisma generate --schema=./prisma/schema; tsc",
    "db:generate": "npx prisma generate --schema=./prisma/schema",
    "db:migrate": "npx prisma migrate dev --schema=./prisma/schema",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=./prisma/schema",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=./prisma/schema",
    "seed": "tsx src/seed.ts",
    "validate-env": "tsx src/validate-env.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^1.0.0"
  }
}

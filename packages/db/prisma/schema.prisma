// ─── Witylogix Database Schema ──────────────────────────────
// PostgreSQL 16 + PostGIS + Row-Level Security
// All tenant-scoped tables carry shopId with RLS policies
//
// NOTE: RLS policies are applied via SQL migrations (see migrations/)
// Prisma does not natively manage RLS; we use raw SQL in migration files.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto, uuid_ossp(map: "uuid-ossp")]
}

// ─── SHOPS (Tenant Root) ────────────────────────────────────

model Shop {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopifyDomain       String   @unique @map("shopify_domain")
  shopifyAccessToken  String   @map("shopify_access_token") // encrypted at app layer
  shopifyShopId       String   @unique @map("shopify_shop_id")
  name                String
  email               String?
  phone               String?
  timezone            String   @default("UTC")
  currency            String   @default("USD")
  planTier            PlanTier @default(FREE) @map("plan_tier")
  settings            Json     @default("{}") // branding, notification prefs, POD requirements
  isActive            Boolean  @default(true) @map("is_active")
  installedAt         DateTime @default(now()) @map("installed_at")
  uninstalledAt       DateTime? @map("uninstalled_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  orders              Order[]
  drivers             Driver[]
  deliveryZones       DeliveryZone[]
  timeSlots           TimeSlot[]
  routes              Route[]
  notificationLogs    NotificationLog[]
  carrierServices     CarrierService[]
  webhookSubscriptions WebhookSubscription[]
  users               User[]

  @@map("shops")
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

// ─── USERS (Dashboard Users per Shop) ───────────────────────

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  email     String
  name      String
  role      UserRole @default(ADMIN)
  password  String?  // hashed; null for Shopify-auth users
  isActive  Boolean  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email])
  @@index([shopId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DISPATCHER
  VIEWER
}

// ─── ORDERS ─────────────────────────────────────────────────

model Order {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId              String      @map("shop_id") @db.Uuid
  shopifyOrderId      String      @map("shopify_order_id")
  shopifyOrderNumber  String?     @map("shopify_order_number")
  status              OrderStatus @default(PENDING)

  // Customer info (snapshot at creation)
  customerName        String?     @map("customer_name")
  customerEmail       String?     @map("customer_email")
  customerPhone       String?     @map("customer_phone")

  // Delivery address (denormalized snapshot)
  addressLine1        String?     @map("address_line1")
  addressLine2        String?     @map("address_line2")
  city                String?
  province            String?
  postalCode          String?     @map("postal_code")
  country             String?
  // PostGIS point for spatial queries (longitude, latitude)
  // Stored as Unsupported type — managed via raw SQL in migrations
  deliveryLocation    Unsupported("geometry(Point, 4326)")? @map("delivery_location")

  // Delivery details
  deliveryDate        DateTime?   @map("delivery_date")
  timeSlotId          String?     @map("time_slot_id") @db.Uuid
  driverId            String?     @map("driver_id") @db.Uuid
  routeStopId         String?     @map("route_stop_id") @db.Uuid
  estimatedArrival    DateTime?   @map("estimated_arrival")
  actualDelivery      DateTime?   @map("actual_delivery")

  // Order value
  totalPrice          Decimal?    @map("total_price") @db.Decimal(12, 2)
  totalWeight         Decimal?    @map("total_weight") @db.Decimal(10, 2)
  itemCount           Int         @default(1) @map("item_count")
  lineItems           Json        @default("[]") @map("line_items")

  // Fulfillment
  trackingToken       String?     @unique @map("tracking_token")
  fulfillmentId       String?     @map("fulfillment_id")
  tags                String[]    @default([])
  notes               String?
  metadata            Json        @default("{}") // custom fields

  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  // Relations
  shop                Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  driver              Driver?     @relation(fields: [driverId], references: [id])
  timeSlot            TimeSlot?   @relation(fields: [timeSlotId], references: [id])
  proofOfDelivery     ProofOfDelivery?
  notificationLogs    NotificationLog[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, status, createdAt(sort: Desc)])
  @@index([shopId, driverId])
  @@index([shopId, deliveryDate])
  @@index([trackingToken])
  // GiST index on deliveryLocation created via raw SQL migration
  @@map("orders")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

// ─── DRIVERS ────────────────────────────────────────────────

model Driver {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId           String       @map("shop_id") @db.Uuid
  name             String
  email            String?
  phone            String
  vehicleType      VehicleType  @default(CAR) @map("vehicle_type")
  vehiclePlate     String?      @map("vehicle_plate")
  maxCapacity      Int          @default(20) @map("max_capacity")  // max orders per route
  maxWeight        Decimal?     @map("max_weight") @db.Decimal(10, 2)
  status           DriverStatus @default(OFFLINE)
  isActive         Boolean      @default(true) @map("is_active")

  // PostGIS point for real-time location
  currentLocation  Unsupported("geometry(Point, 4326)")? @map("current_location")
  lastLocationAt   DateTime?    @map("last_location_at")
  heading          Float?       // compass bearing in degrees

  // Push notifications
  fcmToken         String?      @map("fcm_token")

  // Auth
  password         String?      // hashed
  refreshToken     String?      @map("refresh_token")

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  shop             Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders           Order[]
  routeStops       RouteStop[]
  routes           Route[]

  @@unique([shopId, phone])
  @@index([shopId, status])
  // Partial index on active+available drivers created via raw SQL
  // GiST index on currentLocation created via raw SQL
  @@map("drivers")
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_ROUTE
  ON_BREAK
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
  TRUCK
}

// ─── DELIVERY ZONES ────────────────────────────────────────

model DeliveryZone {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  name        String
  // PostGIS polygon geometry for the zone boundary
  boundary    Unsupported("geometry(Polygon, 4326)")? @map("boundary")
  baseRate    Decimal  @default(0) @map("base_rate") @db.Decimal(10, 2)
  perKmRate   Decimal  @default(0) @map("per_km_rate") @db.Decimal(10, 2)
  minOrder    Decimal  @default(0) @map("min_order") @db.Decimal(10, 2)
  freeAbove   Decimal? @map("free_above") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  priority    Int      @default(0) // higher = checked first for overlapping zones
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  timeSlots   TimeSlot[]

  @@index([shopId, isActive])
  // GiST index on boundary created via raw SQL
  @@map("delivery_zones")
}

// ─── TIME SLOTS ─────────────────────────────────────────────

model TimeSlot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  deliveryZoneId  String?  @map("delivery_zone_id") @db.Uuid
  name            String   // e.g. "Morning 9am-12pm"
  startTime       String   @map("start_time") // HH:mm format
  endTime         String   @map("end_time")   // HH:mm format
  daysOfWeek      Int[]    @map("days_of_week") // 0=Sun, 6=Sat
  maxCapacity     Int      @default(50) @map("max_capacity")
  cutoffMinutes   Int      @default(120) @map("cutoff_minutes") // minutes before slot start
  surcharge       Decimal  @default(0) @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deliveryZone    DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  orders          Order[]

  @@index([shopId, isActive])
  @@map("time_slots")
}

// ─── ROUTES ─────────────────────────────────────────────────

model Route {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId          String      @map("shop_id") @db.Uuid
  driverId        String?     @map("driver_id") @db.Uuid
  name            String?
  status          RouteStatus @default(DRAFT)
  date            DateTime    @db.Date
  startAddress    String?     @map("start_address")
  // Optimized waypoints from OR-Tools
  optimizedOrder  Json        @default("[]") @map("optimized_order") // [{sequence, orderId, lat, lng, eta, type}]
  totalDistance    Decimal?    @map("total_distance") @db.Decimal(12, 2) // meters
  totalDuration   Int?        @map("total_duration") // seconds
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  driver          Driver?     @relation(fields: [driverId], references: [id])
  stops           RouteStop[]

  @@index([shopId, date, status])
  @@index([shopId, driverId])
  @@map("routes")
}

enum RouteStatus {
  DRAFT
  OPTIMIZED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model RouteStop {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId         String        @map("route_id") @db.Uuid
  orderId         String?       @map("order_id") @db.Uuid
  driverId        String?       @map("driver_id") @db.Uuid
  sequence        Int
  stopType        StopType      @default(DELIVERY) @map("stop_type")
  status          StopStatus    @default(PENDING)
  estimatedArrival DateTime?    @map("estimated_arrival")
  actualArrival   DateTime?     @map("actual_arrival")
  departedAt      DateTime?     @map("departed_at")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  route           Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver          Driver?       @relation(fields: [driverId], references: [id])

  @@index([routeId, sequence])
  @@map("route_stops")
}

enum StopType {
  PICKUP
  DELIVERY
  RETURN
  DEPOT
}

enum StopStatus {
  PENDING
  EN_ROUTE
  ARRIVED
  COMPLETED
  SKIPPED
  FAILED
}

// ─── PROOF OF DELIVERY ──────────────────────────────────────

model ProofOfDelivery {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @unique @map("order_id") @db.Uuid
  photoUrls       String[] @map("photo_urls")
  signatureUrl    String?  @map("signature_url")
  recipientName   String?  @map("recipient_name")
  // GPS coordinates at delivery
  deliveryLocation Unsupported("geometry(Point, 4326)")? @map("delivery_location")
  notes           String?
  deliveredAt     DateTime @default(now()) @map("delivered_at")
  createdAt       DateTime @default(now()) @map("created_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("proof_of_delivery")
}

// ─── NOTIFICATION LOG ───────────────────────────────────────

model NotificationLog {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId          String              @map("shop_id") @db.Uuid
  orderId         String?             @map("order_id") @db.Uuid
  channel         NotificationChannel
  eventType       String              @map("event_type") // e.g. "order.out_for_delivery"
  recipient       String              // email, phone, or whatsapp number
  status          NotificationStatus  @default(QUEUED)
  providerMsgId   String?             @map("provider_msg_id")
  errorMessage    String?             @map("error_message")
  sentAt          DateTime?           @map("sent_at")
  deliveredAt     DateTime?           @map("delivered_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  shop            Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order           Order?              @relation(fields: [orderId], references: [id])

  @@index([shopId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("notification_logs")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ─── CARRIER SERVICES ───────────────────────────────────────

model CarrierService {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId              String   @map("shop_id") @db.Uuid
  shopifyCarrierId    String?  @map("shopify_carrier_id")
  name                String
  callbackUrl         String   @map("callback_url")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("carrier_services")
}

// ─── WEBHOOK SUBSCRIPTIONS ──────────────────────────────────

model WebhookSubscription {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId              String   @map("shop_id") @db.Uuid
  shopifyWebhookId    String?  @map("shopify_webhook_id")
  topic               String   // e.g. "orders/create"
  callbackUrl         String   @map("callback_url")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, topic])
  @@map("webhook_subscriptions")
}

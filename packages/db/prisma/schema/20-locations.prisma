// ─── LOCATION WORKING HOURS ─────────────────────────────────
// Operating hours per day of week for each location
// Supports seasonal closures and special hours

model LocationWorkingHours {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") // 0-6 (Sunday-Saturday)
  openTime   String?  @map("open_time") // HH:mm format, null = closed
  closeTime  String?  @map("close_time") // HH:mm format
  isClosed   Boolean  @default(false) @map("is_closed")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
  @@map("location_working_hours")
}

// ─── LOCATION CAPACITY ──────────────────────────────────────
// Warehouse/location capacity and current utilization
// Tracks slots for inventory management

model LocationCapacity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId    String   @unique @map("location_id") @db.Uuid
  totalSlots    Int      @map("total_slots") // Total capacity slots
  usedSlots     Int      @default(0) @map("used_slots") // Currently used
  reservedSlots Int      @default(0) @map("reserved_slots") // Reserved but not used
  category      String? // e.g., 'standard', 'cold_storage', 'hazmat'
  lastUpdated   DateTime @default(now()) @map("last_updated") @db.Timestamp()
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("location_capacity")
}

// ─── LOCATION ZONE ASSOCIATION ─────────────────────────────
// Links locations to delivery zones
// Enables point-in-polygon queries and zone-based rules

model LocationZoneLink {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  deliveryZoneId String   @map("delivery_zone_id") @db.Uuid
  priority       Int      @default(0) // Priority order for multi-zone locations
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)

  @@unique([locationId, deliveryZoneId])
  @@index([locationId])
  @@index([deliveryZoneId])
  @@map("location_zone_links")
}


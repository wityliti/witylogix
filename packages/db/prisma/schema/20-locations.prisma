// ═══════════════════════════════════════════════════════════
// PHASE 1 — NEW MODELS (AR: Arjun Rajput, CTO)
// ═══════════════════════════════════════════════════════════
// Architecture principles:
//   1. Models are MODULAR — not a 1:1 copy of the old MongoDB schemas
//   2. Relations are explicit via FK, not buried in JSON blobs
//   3. Enums are fine-grained for type safety, not loose strings
//   4. Indexes are query-driven (we add what the API actually queries)
//   5. JSON fields are only for truly dynamic/schemaless data
//   6. Every model is shop-scoped (RLS) or org-scoped (shared resources)

// ─── LOCATIONS (Warehouse / Store / Hub) ─────────────────
// A physical location from which shipments originate or return.
// Org-level locations are shared across shops. Shop-level locations
// are private. Replaces old storeDetail.locations + warehouse model.

model Location {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String?      @map("org_id") @db.Uuid
  shopId       String?      @map("shop_id") @db.Uuid
  name         String
  type         LocationType @default(WAREHOUSE)
  addressLine1 String       @map("address_line1")
  addressLine2 String?      @map("address_line2")
  city         String
  province     String?
  postalCode   String?      @map("postal_code")
  country      String       @default("US")
  // TODO: Restore PostGIS when available
  coordinates  Json? // { lat: number, lng: number }
  phone        String?
  email        String?
  isDefault    Boolean      @default(false) @map("is_default")
  isActive     Boolean      @default(true) @map("is_active")

  // Operating hours: { monday: { open: "09:00", close: "17:00" }, ... }
  operatingHours  Json? @map("operating_hours")
  // Preparation time in minutes before an order can be dispatched
  prepTimeMinutes Int   @default(0) @map("prep_time_minutes")

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization             Organization?             @relation(fields: [orgId], references: [id])
  shop                     Shop?                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shipments                Shipment[]
  shippingProfileLocations ShippingProfileLocation[]
  workingHours             LocationWorkingHours[]
  capacity                 LocationCapacity?
  zoneLinks                LocationZoneLink[]
  profileLocationLinks     ProfileLocationLink[]
  deliverySlots            DeliverySlot[]
  capacityConfigs          CapacityConfig[]
  blackoutDates            BlackoutDate[]
  deadlineConfig           DeadlineConfig?
  surgePrices              SurgePrice[]

  @@index([orgId, isActive])
  @@index([shopId, isActive])
  @@map("locations")
}

enum LocationType {
  WAREHOUSE
  STORE
  HUB
  DEPOT
  PICKUP_POINT
}


// ─── SHIPMENT ITEMS (Line Items in a Shipment) ────────────────
// Detailed line item level data for each product in a shipment
// Enables tracking of customs, weight, dimensions per item

model ShipmentItem {
  id String @id @default(cuid())
  shipmentId String
  productId String?
  variantId String?
  sku String?
  title String
  quantity Int
  weight Decimal? @db.Decimal(10, 3)
  weightUnit String @default("kg")
  length Decimal? @db.Decimal(10, 2)
  width Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)
  dimensionUnit String @default("cm")
  customsValue Decimal? @db.Decimal(10, 2)
  customsCurrency String @default("usd")
  hsCode String?
  originCountry String?
  shopId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([shopId])
  @@map("shipment_items")
}

// ─── TENANT NOTIFICATION INBOX ──────────────────────────────
// Admin-facing notification inbox (e.g. "New order from John", "Driver offline")
// Distinct from NotificationLog which tracks outbound delivery events.

model TenantNotification {
  id         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId     String                     @map("shop_id") @db.Uuid
  title      String
  message    String                     @db.Text
  category   TenantNotificationCategory @default(SYSTEM)
  channel    TenantNotificationChannel  @default(PUSH)
  status     TenantNotificationStatus   @default(UNREAD)
  actionUrl  String?                    @map("action_url")
  metadata   Json                       @default("{}")
  createdAt  DateTime                   @default(now()) @map("created_at")
  readAt     DateTime?                  @map("read_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([shopId, createdAt(sort: Desc)])
  @@map("tenant_notifications")
}

enum TenantNotificationCategory {
  ORDERS
  DELIVERIES
  DRIVERS
  PAYMENTS
  SYSTEM
  ALERTS
}

enum TenantNotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
  WEBHOOK
  SLACK
}

enum TenantNotificationStatus {
  UNREAD
  READ
  ARCHIVED
  DISMISSED
}

// ─── NOTIFICATION LOG ───────────────────────────────────────

model NotificationLog {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId        String              @map("shop_id") @db.Uuid
  orderId       String?             @map("order_id") @db.Uuid
  channel       NotificationChannel
  eventType     String              @map("event_type")
  recipient     String
  status        NotificationStatus  @default(QUEUED)
  providerMsgId String?             @map("provider_msg_id")
  errorMessage  String?             @map("error_message")
  sentAt        DateTime?           @map("sent_at")
  deliveredAt   DateTime?           @map("delivered_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id])

  @@index([shopId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("notification_logs")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

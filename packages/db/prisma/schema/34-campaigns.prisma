// ─── CAMPAIGNS ───────────────────────────────────────────────────────────
// Campaign management for email, SMS, WhatsApp, and push notifications
// Includes execution tracking, stats, and event logging

model Campaign {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  shopId        String             @map("shop_id") @db.Uuid
  name          String
  description   String?
  type          CampaignType       // email, sms, whatsapp, push, multi_channel
  status        CampaignStatus     @default(DRAFT)
  templateId    String?            @map("template_id") @db.Uuid

  // Audience targeting
  audienceFilter Json               @default("{}") @map("audience_filter")

  // Scheduling
  scheduledAt   DateTime?          @map("scheduled_at")
  startedAt     DateTime?          @map("started_at")
  completedAt   DateTime?          @map("completed_at")

  // Stats tracking (denormalized for performance)
  sentCount     Int                @default(0) @map("sent_count")
  deliveredCount Int               @default(0) @map("delivered_count")
  openedCount   Int                @default(0) @map("opened_count")
  clickedCount  Int                @default(0) @map("clicked_count")
  bouncedCount  Int                @default(0) @map("bounced_count")
  failedCount   Int                @default(0) @map("failed_count")
  unsubscribedCount Int            @default(0) @map("unsubscribed_count")

  // Audit & metadata
  createdBy     String             @map("created_by") @db.Uuid
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events        CampaignEvent[]

  @@index([tenantId, status])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

// ─── BROADCAST GROUPS ──────────────────────────────────────────────────────
// Groups of recipients for bulk messaging

model BroadcastGroup {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  shopId        String             @map("shop_id") @db.Uuid
  name          String
  description   String?
  memberFilter  Json?              @map("member_filter") // Filter criteria for dynamic membership
  memberCount   Int                @default(0) @map("member_count") // Cached count
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  members       BroadcastGroupMember[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([shopId])
  @@map("broadcast_groups")
}

// ─── BROADCAST GROUP MEMBERS ──────────────────────────────────────────────
// Individual members of a broadcast group

model BroadcastGroupMember {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId       String             @map("group_id") @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  addedAt       DateTime           @default(now()) @map("added_at")

  group         BroadcastGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, customerId])
  @@index([groupId])
  @@index([customerId])
  @@map("broadcast_group_members")
}

// ─── CAMPAIGN EVENTS ──────────────────────────────────────────────────────
// Event log for campaign tracking (sent, delivered, opened, clicked, etc.)

model CampaignEvent {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId    String             @map("campaign_id") @db.Uuid
  messageId     String             @map("message_id")
  recipientId   String             @map("recipient_id") @db.Uuid
  event         CampaignEventType
  timestamp     DateTime           @default(now())
  metadata      Json               @default("{}")

  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, event])
  @@index([campaignId, timestamp(sort: Desc)])
  @@index([recipientId, timestamp(sort: Desc)])
  @@index([messageId])
  @@map("campaign_events")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  MULTI_CHANNEL

  @@map("campaign_type")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED

  @@map("campaign_status")
}

enum CampaignEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
  COMPLAINED

  @@map("campaign_event_type")
}

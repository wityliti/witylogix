// ─── PROOF OF DELIVERY (POD) ───────────────────────────────────────
// Multi-method proof of delivery storage
// Supports: photo, signature, QR code, barcode, manual confirmation

model ProofOfDelivery {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId  String   @map("delivery_id") @db.Uuid

  // Method: photo | signature | qr_scan | barcode | manual_confirm
  method      String   @map("method")
  status      String   @default("pending") @map("status") // pending, verified, rejected, failed

  // Photo POD fields
  photoUrl    String?  @map("photo_url")
  photoKey    String?  @map("photo_key") // Storage key for cloud uploads
  thumbnailUrl String? @map("thumbnail_url")
  photoMetadata Json?  @map("photo_metadata") // Width, height, format, size, EXIF, geolocation

  // Signature POD fields
  signerName  String?  @map("signer_name")
  signatureUrl String? @map("signature_url")
  signatureKey String? @map("signature_key") // Storage key for rendered signature PNG
  signatureData Json?  @map("signature_data") // SVG path or point array

  // QR Code POD fields
  qrScannedData String? @map("qr_scanned_data")
  qrExpectedData String? @map("qr_expected_data")
  qrVerification Json?  @map("qr_verification") // Contains matchPercentage, decodedInfo

  // Barcode POD fields
  barcodeScanned String? @map("barcode_scanned")
  barcodeExpected String? @map("barcode_expected")
  barcodeFormat String?  @map("barcode_format") // CODE128, EAN13, etc.
  barcodeVerification Json? @map("barcode_verification")

  // Manual confirmation fields
  confirmedBy String?  @map("confirmed_by")
  confirmationNotes String? @map("confirmation_notes")

  // Verification tracking
  capturedAt  DateTime @default(now()) @map("captured_at")
  verifiedAt  DateTime? @map("verified_at")

  // Metadata and audit
  metadata    Json     @default("{}") // Additional data (device info, etc.)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([deliveryId, method]) // One POD per method per delivery
  @@index([deliveryId])
  @@index([method])
  @@index([status])
  @@index([verifiedAt])
  @@map("proofs_of_delivery")
}

// ─── DELIVERY TIMELINE ──────────────────────────────────────────────
// Track delivery status progression with attachments

model DeliveryTimeline {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId  String   @map("delivery_id") @db.Uuid

  // Event: CREATED, CONFIRMED, PICKED_UP, OUT_FOR_DELIVERY, ARRIVED, DELIVERED, FAILED, RESCHEDULED, RETURNED
  event       String   @map("event")

  // Status: pending, confirmed, picked_up, out_for_delivery, arrived, delivered, failed, rescheduled, returned
  status      String   @map("status")

  description String   @map("description") // Human readable event description

  // Location tracking
  latitude    Float?   @map("latitude")
  longitude   Float?   @map("longitude")

  // Attachments (from timeline event)
  photoUrl    String?  @map("photo_url")
  photoKey    String?  @map("photo_key")
  signatureUrl String? @map("signature_url")
  signatureKey String? @map("signature_key")

  // Metadata
  notes       String?  @map("notes")
  metadata    Json     @default("{}") // Event-specific data

  // Timestamps
  timestamp   DateTime @default(now()) @map("timestamp")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([deliveryId])
  @@index([event])
  @@index([status])
  @@index([timestamp])
  @@index([deliveryId, timestamp]) // For timeline queries
  @@map("delivery_timeline")
}

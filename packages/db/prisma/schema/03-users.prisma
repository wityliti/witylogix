// ─── USERS (Dashboard Users) ────────────────────────────────
// Users are created per-shop (via Shopify install, invite, or
// platform registration). Optionally linked to an org via
// OrgMember for cross-shop access.

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid // primary shop (where they were created)
  email           String
  name            String
  phone           String? // optional contact number
  role            UserRole  @default(ADMIN)
  password        String? // hashed; null for Shopify-auth users
  emailVerifiedAt DateTime? @map("email_verified_at") // null = not yet verified
  isActive        Boolean   @default(true) @map("is_active")
  lastLogin       DateTime? @map("last_login")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  shop                 Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orgMembers           OrgMember[] // org-level access (if any)
  authSessions         AuthSession[] // sessions with auth providers
  platformAdmin        PlatformAdmin? // if this user is a platform admin
  externalAuthSessions ExternalAuthSession[]
  mfaDevices           MfaDevice[]
  loginAttempts        LoginAttempt[]
  apiKeys              ApiKey[]
  onboardingProgress   OnboardingProgress?

  @@unique([shopId, email])
  @@index([shopId])
  @@index([email]) // for cross-shop login lookups
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DISPATCHER
  VIEWER
}

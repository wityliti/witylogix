node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/
.temp/
out/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.sql.bak

# OSRM data (large binary files)
infra/osrm/*.osm.pbf
infra/osrm/*.osrm*

# Coverage
coverage/

# Docker
docker-compose.override.yml

# Prisma
packages/db/prisma/migrations/**/migration_lock.toml
packages/db/src/generated/

# pnpm workspaces — prevent accidental npm lockfiles from leaking in
apps/*/package-lock.json
packages/*/package-lock.json

# Vite/Vitest timestamp cache files
**/*.timestamp-*.mjs

# Claude-Flow runtime state
**/.claude-flow/

# Playwright
**/playwright-report/
**/test-results/
**/blob-report/
**/.playwright/
**/*.webm
**/trace.zip

# TypeScript incremental build cache
**/*.tsbuildinfo

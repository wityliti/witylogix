#!/usr/bin/env bash
#
# Witylogix CLI — Deploy and manage Witylogix on any VM
#
# One-line deployment to Ubuntu 20.04+, Debian 10+, Amazon Linux 2
#
# Usage:
#   witylogix [global-flags] [command] [options]
#
# Global Flags:
#   --yes       Non-interactive mode (accept all prompts)
#   --verbose   Show detailed output
#   --quiet     Suppress non-error output
#   --version   Show version and exit
#   --help      Show help and exit
#
# Commands:
#   install     One-time VM setup: install Docker, pull images
#   deploy      Start/restart services with current config
#   upgrade     Upgrade to newer Witylogix version
#   status      Show health of all services
#   logs        Stream or fetch service logs
#   backup      Backup database, configs, and data
#   restore     Restore from backup
#   ssl         SSL/TLS certificate management
#   env         Manage environment variables
#   doctor      Diagnostic and troubleshooting
#   dev         Development mode with hot reload
#   init        Initialize configuration on new machine
#   scale       Horizontal scaling (multiple API instances)
#   destroy     Teardown all services
#   ai          AI-assisted setup and diagnosis
#
# Examples:
#   witylogix install --domain api.example.com --env production
#   witylogix deploy
#   witylogix status
#   witylogix logs api
#   witylogix --help
#

set -euo pipefail

# Version
VERSION="1.0.0"

# Directories
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WITYLOGIX_HOME="${WITYLOGIX_HOME:-$HOME/.witylogix}"
CLI_DIR="$SCRIPT_DIR"
COMMANDS_DIR="$CLI_DIR/commands"
LIB_DIR="$CLI_DIR/lib"
TEMPLATES_DIR="$CLI_DIR/templates"

# Global flags (parsed from args)
YES_MODE=false
VERBOSE_MODE=false
QUIET_MODE=false
COMMAND=""
COMMAND_ARGS=()

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Logging functions
log_info() {
  if [[ "$QUIET_MODE" != "true" ]]; then
    echo -e "${GREEN}[witylogix]${NC} $1"
  fi
}

log_warn() {
  if [[ "$QUIET_MODE" != "true" ]]; then
    echo -e "${YELLOW}[witylogix]${NC} $1" >&2
  fi
}

log_error() {
  echo -e "${RED}[witylogix]${NC} $1" >&2
}

log_success() {
  if [[ "$QUIET_MODE" != "true" ]]; then
    echo -e "${GREEN}✓${NC} $1"
  fi
}

log_step() {
  if [[ "$QUIET_MODE" != "true" ]]; then
    echo -e "${BOLD}${BLUE}→${NC} $1"
  fi
}

log_cmd() {
  if [[ "$VERBOSE_MODE" = "true" ]]; then
    echo -e "${CYAN}  →${NC} $1"
  fi
}

log_verbose() {
  if [[ "$VERBOSE_MODE" = "true" ]]; then
    echo -e "${DIM}  $1${NC}"
  fi
}

# Banner function
banner() {
  echo ""
  echo -e "${BOLD}${CYAN}"
  echo "╔═══════════════════════════════════════╗"
  echo "║  Witylogix CLI v$VERSION                  ║"
  echo "║  Deploy & Manage Your Infrastructure  ║"
  echo "╚═══════════════════════════════════════╝"
  echo -e "${NC}"
}

# Config loader
load_config() {
  local config_file="$WITYLOGIX_HOME/config"
  if [[ -f "$config_file" ]]; then
    log_verbose "Loading config from $config_file"
    # Source config safely (only key=value lines)
    set +u
    source "$config_file" 2>/dev/null || log_warn "Failed to load config file"
    set -u
  fi
}

# Help function
show_help() {
  cat << 'EOF'
Witylogix CLI — Deploy and manage Witylogix

USAGE:
  witylogix [global-flags] [command] [options]

GLOBAL FLAGS:
  --yes       Accept all prompts (non-interactive mode)
  --verbose   Show detailed output including commands
  --quiet     Suppress non-error output
  --version   Show version and exit
  --help      Show this help and exit

COMMANDS:
  install     One-time VM setup: install Docker, pull images
              witylogix install --domain api.example.com --env production

  deploy      Start/restart services with current config
              witylogix deploy --force --build

  upgrade     Upgrade to newer Witylogix version
              witylogix upgrade --to latest

  status      Show health of all services
              witylogix status [--json]

  logs        Stream or fetch service logs
              witylogix logs [SERVICE] [--lines 100] [--follow]

  backup      Backup database, configs, and data
              witylogix backup [--name LABEL] [--destination PATH]

  restore     Restore from backup
              witylogix restore BACKUP_FILE [--force]

  ssl         SSL/TLS certificate management
              witylogix ssl status | renew | set-domain DOMAIN

  env         Manage environment variables
              witylogix env list | get KEY | set KEY VALUE | unset KEY

  doctor      Diagnostic and troubleshooting
              witylogix doctor [--verbose]

  dev         Development mode with hot reload
              witylogix dev [--service SERVICE] [--watch-dir PATH]

  init        Initialize configuration on new machine
              witylogix init [--interactive] [--config-file PATH]

  scale       Horizontal scaling (multiple API instances)
              witylogix scale --api-replicas 3 --dashboard-replicas 2

  destroy     Teardown all services
              witylogix destroy [--keep-data] [--force]

  ai          AI-assisted setup and diagnosis
              witylogix ai setup | diagnose

EXAMPLES:
  Initial deployment:
    witylogix install --domain api.example.com --env production
    witylogix deploy

  Check status:
    witylogix status
    witylogix logs api --follow

  Maintenance:
    witylogix backup --name daily-backup
    witylogix upgrade
    witylogix doctor

CONFIGURATION:
  Witylogix stores settings in: ~/.witylogix/config
  Edit manually to customize install directory, ports, etc.

ENVIRONMENT:
  WITYLOGIX_HOME    Directory for config and backups (default: ~/.witylogix)
  VERBOSE           Set to 1 for verbose output

For command-specific help:
  witylogix [command] --help
EOF
}

# Parse global flags and command
parse_args() {
  local args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes)
        YES_MODE=true
        shift
        ;;
      --verbose)
        VERBOSE_MODE=true
        shift
        ;;
      --quiet)
        QUIET_MODE=true
        shift
        ;;
      --version)
        echo "witylogix $VERSION"
        exit 0
        ;;
      --help)
        show_help
        exit 0
        ;;
      -h)
        show_help
        exit 0
        ;;
      -*)
        log_error "Unknown global flag: $1"
        show_help
        exit 2
        ;;
      *)
        # First non-flag argument is the command
        COMMAND="$1"
        shift
        # Collect remaining args for the command
        while [[ $# -gt 0 ]]; do
          COMMAND_ARGS+=("$1")
          shift
        done
        break
        ;;
    esac
  done
}

# Error handler
trap_error() {
  local line_number=$1
  log_error "An error occurred on line $line_number"
  log_error "For troubleshooting, run: witylogix doctor --verbose"
  exit 1
}

trap 'trap_error ${LINENO}' ERR

# Load shared library
load_library() {
  local lib_file="$LIB_DIR/common.sh"
  if [[ ! -f "$lib_file" ]]; then
    log_error "Cannot find shared library: $lib_file"
    log_error "CLI installation may be corrupted. Reinstall Witylogix."
    exit 1
  fi
  log_verbose "Sourcing library from $lib_file"
  source "$lib_file"
}

# Route to subcommand
route_command() {
  local cmd="$COMMAND"

  if [[ -z "$cmd" ]]; then
    cmd="deploy"  # Default command
  fi

  local cmd_file="$COMMANDS_DIR/$cmd.sh"

  if [[ ! -f "$cmd_file" ]]; then
    log_error "Unknown command: $cmd"
    log_error "Run 'witylogix --help' to see available commands"
    exit 1
  fi

  log_verbose "Loading command: $cmd_file"
  # Source command file and call the handler
  source "$cmd_file"

  # Call the command handler function
  local cmd_func="cmd_$cmd"
  if ! declare -f "$cmd_func" > /dev/null; then
    log_error "Command handler not found: $cmd_func"
    exit 1
  fi

  log_verbose "Executing: $cmd_func"
  "$cmd_func" "${COMMAND_ARGS[@]}"
}

# Main entry point
main() {
  # Ensure config directory exists
  mkdir -p "$WITYLOGIX_HOME"

  # Show banner if not quiet and not just printing version/help
  if [[ "$QUIET_MODE" != "true" && "$COMMAND" != "version" && "$COMMAND" != "help" ]]; then
    banner
  fi

  # Parse arguments
  parse_args "$@"

  # Load configuration
  load_config

  # Load shared library
  load_library

  # Route to command
  route_command

  # Success
  log_verbose "Command completed successfully"
}

# Run main
main "$@"

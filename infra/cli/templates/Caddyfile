}

# ─────────────────────────────────────────────────────────────────────────────
# Health Check Endpoint: caddy-health
# ─────────────────────────────────────────────────────────────────────────────
# This endpoint is used by container orchestration and monitoring systems
# to verify that the Caddy service is operational and responding
localhost:2019 {
	# Direct health check response - returns 200 OK with simple JSON
	# This is not forwarded to any backend service
	respond /caddy-health "OK" 200
}

{
  "dashboard": {
    "title": "Business Metrics",
    "description": "Key business metrics and KPIs for Witylogix platform",
    "tags": ["business", "kpi", "metrics"],
    "timezone": "UTC",
    "refresh": "60s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(orders_created_total, environment)",
          "current": {"value": "production", "text": "production"}
        },
        {
          "name": "region",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(orders_created_total{environment=\"$environment\"}, region)",
          "current": {"value": "all", "text": "All"},
          "multi": true
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Orders Created/Hour",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(increase(orders_created_total{environment=\"$environment\",region=~\"$region\"}[1h]))"
          }
        ],
        "gridPos": {"h": 6, "w": 4, "x": 0, "y": 0},
        "options": {"colorMode": "value"}
      },
      {
        "id": 2,
        "title": "Deliveries Completed/Hour",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(increase(deliveries_completed_total{environment=\"$environment\",region=~\"$region\"}[1h]))"
          }
        ],
        "gridPos": {"h": 6, "w": 4, "x": 4, "y": 0},
        "options": {"colorMode": "value"}
      },
      {
        "id": 3,
        "title": "Active Drivers",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(drivers_active{environment=\"$environment\",region=~\"$region\"})"
          }
        ],
        "gridPos": {"h": 6, "w": 4, "x": 8, "y": 0},
        "options": {"colorMode": "value"}
      },
      {
        "id": 4,
        "title": "Average Delivery Time (min)",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "avg(delivery_time_minutes{environment=\"$environment\",region=~\"$region\"})"
          }
        ],
        "gridPos": {"h": 6, "w": 4, "x": 12, "y": 0},
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 25},
                {"color": "red", "value": 35}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "SLA Compliance (%)",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "100 * (sum(deliveries_on_time_total{environment=\"$environment\",region=~\"$region\"}) / sum(deliveries_completed_total{environment=\"$environment\",region=~\"$region\"}))"
          }
        ],
        "gridPos": {"h": 6, "w": 4, "x": 16, "y": 0},
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 95},
                {"color": "green", "value": 98}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Daily Revenue",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(increase(revenue_cents{environment=\"$environment\",region=~\"$region\"}[1d])) / 100",
            "legendFormat": "Revenue ($)"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6},
        "yaxes": [{"label": "USD"}]
      },
      {
        "id": 7,
        "title": "Top Integration Providers",
        "type": "table",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "topk(10, sum(integrations_requests_total{environment=\"$environment\",region=~\"$region\"}[24h]) by (provider))",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6}
      },
      {
        "id": 8,
        "title": "Onboarding Completion Rate (%)",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "100 * (sum(tenants_onboarding_completed_total{environment=\"$environment\",region=~\"$region\"}) / sum(tenants_signup_total{environment=\"$environment\",region=~\"$region\"}))"
          }
        ],
        "gridPos": {"h": 8, "w": 4, "x": 16, "y": 6},
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 80}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Tenant Growth (30-day moving average)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "increase(tenants_active_total{environment=\"$environment\",region=~\"$region\"}[30d])",
            "legendFormat": "New Tenants"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}
      },
      {
        "id": 10,
        "title": "Order Status Breakdown",
        "type": "piechart",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(orders_status_total{environment=\"$environment\",region=~\"$region\"}) by (status)",
            "legendFormat": "{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}
      }
    ]
  }
}

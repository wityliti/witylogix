{
  "dashboard": {
    "title": "Database Performance",
    "description": "PostgreSQL database performance and health monitoring",
    "tags": ["database", "postgresql", "performance"],
    "timezone": "UTC",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(pg_stat_activity, environment)",
          "current": {"value": "production", "text": "production"}
        },
        {
          "name": "database",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(pg_stat_activity{environment=\"$environment\"}, datname)",
          "current": {"value": "witylogix", "text": "witylogix"}
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Active Connections",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(pg_stat_activity{environment=\"$environment\",datname=\"$database\"})"
          }
        ],
        "gridPos": {"h": 6, "w": 4, "x": 0, "y": 0},
        "options": {"graphMode": "area", "colorMode": "value"}
      },
      {
        "id": 2,
        "title": "Connection Pool Utilization (%)",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "100 * (pg_stat_activity{environment=\"$environment\",datname=\"$database\"} / pg_settings_max_connections{environment=\"$environment\"})"
          }
        ],
        "gridPos": {"h": 6, "w": 4, "x": 4, "y": 0},
        "options": {"orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true},
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 80},
                {"color": "red", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Query Duration (P50/P95/P99)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(pg_query_duration_seconds_bucket{environment=\"$environment\",datname=\"$database\"}[1m])) by (le))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(pg_query_duration_seconds_bucket{environment=\"$environment\",datname=\"$database\"}[1m])) by (le))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(pg_query_duration_seconds_bucket{environment=\"$environment\",datname=\"$database\"}[1m])) by (le))",
            "legendFormat": "P99"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6},
        "yaxes": [{"label": "seconds"}]
      },
      {
        "id": 4,
        "title": "Slow Queries Count",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "increase(pg_slow_queries_total{environment=\"$environment\",datname=\"$database\"}[5m])"
          }
        ],
        "gridPos": {"h": 8, "w": 4, "x": 8, "y": 6},
        "options": {"graphMode": "area"}
      },
      {
        "id": 5,
        "title": "Cache Hit Ratio (%)",
        "type": "gauge",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "100 * sum(pg_cache_hits{environment=\"$environment\",datname=\"$database\"}) / (sum(pg_cache_hits{environment=\"$environment\",datname=\"$database\"}) + sum(pg_cache_misses{environment=\"$environment\",datname=\"$database\"}))"
          }
        ],
        "gridPos": {"h": 8, "w": 4, "x": 12, "y": 6},
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 80},
                {"color": "green", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Deadlocks",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "increase(pg_deadlocks_total{environment=\"$environment\",datname=\"$database\"}[1h])"
          }
        ],
        "gridPos": {"h": 8, "w": 4, "x": 16, "y": 6},
        "options": {"colorMode": "background"}
      },
      {
        "id": 7,
        "title": "Replication Lag (seconds)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pg_replication_lag_seconds{environment=\"$environment\",datname=\"$database\"}"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
        "yaxes": [{"label": "seconds"}]
      },
      {
        "id": 8,
        "title": "Top 10 Largest Tables",
        "type": "table",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "topk(10, pg_table_size_bytes{environment=\"$environment\",datname=\"$database\"})",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14}
      },
      {
        "id": 9,
        "title": "Index Usage",
        "type": "table",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "pg_index_usage_ratio{environment=\"$environment\",datname=\"$database\"}",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14}
      }
    ],
    "alerts": [
      {
        "name": "Connection Pool > 80%",
        "condition": "100 * (pg_stat_activity / pg_settings_max_connections) > 80",
        "duration": "5m"
      },
      {
        "name": "Replication Lag > 5s",
        "condition": "pg_replication_lag_seconds > 5",
        "duration": "5m"
      },
      {
        "name": "Deadlocks > 0",
        "condition": "increase(pg_deadlocks_total[1h]) > 0",
        "duration": "1m"
      }
    ]
  }
}

# Database Configuration
# PostgreSQL connection credentials - REQUIRED
DB_USER=witylogix
DB_PASSWORD=your_secure_postgres_password_here

# Redis Configuration
# Redis password for authentication - RECOMMENDED
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Configuration
# Secret key for signing JWT tokens - REQUIRED
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# Shopify Configuration
# Shopify app API credentials - REQUIRED for Shopify integration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# Application Environment
# Keep as 'production' for production deployments
NODE_ENV=production

# API Configuration
# Port for API server
PORT=3001

# Logging
# Log level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# CORS Configuration (optional)
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting (optional)
# Maximum requests per minute per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Database Pool Configuration (optional)
# Connection pool size
DB_POOL_MIN=2
DB_POOL_MAX=10

# Email Configuration (optional)
# SMTP credentials if sending emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@witylogix.com

# AWS Configuration (optional)
# S3 bucket for file storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=witylogix-prod-bucket

# Sentry Configuration (optional)
# Error tracking and monitoring
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# New Relic Configuration (optional)
# Application performance monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# Feature Flags (optional)
# Enable/disable specific features
FEATURE_SHOPIFY_INTEGRATION=true
FEATURE_REAL_TIME_TRACKING=true
FEATURE_BULK_IMPORT=true
